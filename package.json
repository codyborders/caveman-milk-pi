{
  "name": "@tomooshi/caveman-milk-pi",
  "version": "0.3.0",
  "description": "Opt-in Pi extension with compact, deterministic response-style prompts.",
  "main": "index.ts",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "caveman",
    "token-efficiency",
    "terseness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomooshi/caveman-milk-pi.git"
  },
  "homepage": "https://github.com/tomooshi/caveman-milk-pi",
  "license": "MIT",
  "author": "tomooshi",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/",
    "skill/",
    "scripts/evaluate.mjs",
    "scripts/evaluation-fixtures.json",
    "README.md",
    "CREDITS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "evaluate": "node scripts/evaluate.mjs",
    "evaluate:offline": "node scripts/evaluate.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
