{
  "name": "@codyborders/caveman-milk-pi",
  "version": "0.4.0-beta.1",
  "description": "Opt-in Pi extension with compact, deterministic response-style prompts.",
  "main": "index.ts",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "caveman",
    "token-efficiency",
    "terseness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codyborders/caveman-milk-pi.git"
  },
  "homepage": "https://github.com/codyborders/caveman-milk-pi",
  "bugs": {
    "url": "https://github.com/codyborders/caveman-milk-pi/issues"
  },
  "license": "MIT",
  "author": "codyborders",
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/",
    "skill/",
    "README.md",
    "CREDITS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/package-smoke.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "evaluate": "node scripts/evaluate.mjs",
    "evaluate:offline": "node scripts/evaluate.mjs",
    "rescore:offline": "node scripts/eval/rescore.mjs",
    "test:package": "node scripts/smoke-packed.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "typescript": "^6.0.2",
    "@types/node": "^25.6.0",
    "vitest": "^4.1.4"
  }
}
